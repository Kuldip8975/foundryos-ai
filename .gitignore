foundryos-tokens.txt
*tokens*.txt
*.dump
deploy/backups/
service-account*.json
foundryos-db-config.patch

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
pip-wheel-metadata/

# --- Node / frontend ---
node_modules/
frontend/dist/
frontend/coverage/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vite/

# --- Local data & uploads (never commit company data) ---
data/
uploads/
exports/
*.sqlite
*.db

# --- Logs ---
logs/
*.log

# --- Editors / OS ---
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

