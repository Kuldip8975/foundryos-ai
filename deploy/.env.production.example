# FoundryOS AI - production settings. Copy to deploy/.env ON THE SERVER ONLY
# and fill in. Never commit the filled-in file.

# Which stack to run (docker compose reads this automatically):
#   docker-compose.aws-api.yml  web client on Cloudflare Pages, API via AWS API Gateway (recommended)
#   docker-compose.prod.yml     everything on this server with its own domain (Caddy HTTPS)
COMPOSE_FILE=docker-compose.aws-api.yml

# --- Cloudflare Pages + API Gateway (docker-compose.aws-api.yml) ---
# The Pages address that may call the API, e.g. https://foundryos.pages.dev
FRONTEND_ORIGIN=
# From your computer: terraform output -raw origin_secret
ORIGIN_SECRET=

# --- Own domain only (docker-compose.prod.yml) ---
# SITE_DOMAIN=foundryos.example.com
# ACME_EMAIL=you@example.com

# Database (generate the password with: openssl rand -hex 24)
POSTGRES_USER=foundryos
POSTGRES_PASSWORD=
POSTGRES_DB=foundryos

# Public demo: shared demo accounts shown on the sign-in page.
# Leave PUBLIC_DEMO_PASSWORD empty and DEMO_MODE=false for a private plant.
DEMO_MODE=true
PUBLIC_DEMO_PASSWORD=

# AI (off by default; a public demo with AI on can cost money - see docs)
AI_REPORTS_ENABLED=false
AI_WORKFLOW_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_THINKING_LEVEL=low
